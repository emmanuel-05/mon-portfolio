# ==============================================================================
# Modèle de Configuration Environnement - Django, PostgreSQL & Docker
# ==============================================================================

# --- Sécurité & Mode Django ---
DEBUG=False
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
DJANGO_SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,169.58.171.214,portfolio-gnamien.faslab.online,test.ibson.online
CSRF_TRUSTED_ORIGINS=http://localhost http://127.0.0.1 http://169.58.171.214:81 https://portfolio-gnamien.faslab.online http://test.ibson.online

# --- Configuration CORS ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost http://127.0.0.1 http://169.58.171.214:81 https://portfolio-gnamien.faslab.online http://test.ibson.online

# Sécurité des Cookies (optionnel, par défaut True si DEBUG=False)
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# --- Base de données PostgreSQL ---
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://portfolio_user:your_secure_postgres_password@db:5432/portfolio_db

# --- Identifiants Superutilisateur ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin_secure_password

# --- Ports des Services Docker ---
FRONTEND_PORT=81
BACKEND_PORT=8000