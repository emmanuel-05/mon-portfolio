# ==============================================================================
# Configuration Environnement - Django & PostgreSQL
# ==============================================================================

# Sécurité Django
DEBUG=False
DJANGO_SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,your-vps-ip,yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost http://127.0.0.1 http://your-vps-ip https://yourdomain.com

# Base de données PostgreSQL
POSTGRES_DB=portfolio_db
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=your_secure_postgres_password

# URL de connexion PostgreSQL pour Django
DATABASE_URL=postgres://portfolio_user:your_secure_postgres_password@db:5432/portfolio_db

# Identifiants du Superutilisateur créé automatiquement au premier démarrage
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin_secure_password